# =============================================================================
# SPECFORGE — VARIABLES DE ENTORNO
# Copia este archivo como .env. NUNCA subas el .env con claves reales.
#
# Para empezar basta con UNA clave gratis (recomendado: GEMINI_API_KEY).
# Cada agente usa una cadena de proveedores: si uno no tiene clave o llega a
# su límite gratis, el sistema pasa solo al siguiente (ver core/config.py).
# =============================================================================

# --- APIs con plan gratis (todas opcionales; basta con una) -------------------
# Google AI Studio — https://aistudio.google.com/apikey (sin tarjeta)
GEMINI_API_KEY=
# Groq — https://console.groq.com/keys (muy rápido; Jarvis la usa para la voz)
GROQ_API_KEY=
# Cerebras — https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# OpenRouter — https://openrouter.ai/keys (modelos con sufijo :free)
OPENROUTER_API_KEY=
# GitHub Models — token de GitHub con permiso "models:read"
GITHUB_MODELS_TOKEN=
# NVIDIA NIM — https://build.nvidia.com (créditos gratis)
NVIDIA_API_KEY=

# --- Suscripciones vía CLI (sin clave aquí) -----------------------------------
# Si el CLI está instalado y con sesión iniciada, se usa automáticamente:
#   claude  → Claude Code CLI con plan Claude Pro/Max      (claude, luego /login)
#   agy     → Antigravity CLI con tu cuenta de Google o Google AI Pro (agy)
# Son para uso personal; para un servicio con usuarios usa las APIs de arriba.

# Qué usar: auto (cuentas primero + APIs gratis de respaldo) | cuentas | gratis
SPECFORGE_MODO=auto
# Comprueba qué responde de verdad: python -m providers.diagnostico

# --- Cadenas de proveedores (opcional) ----------------------------------------
# Formato: proveedor:modelo,proveedor:modelo,...  (modelo vacío = el del CLI)
# Niveles: SMART (razonamiento), CODE (código), FAST (tareas rápidas), VISION
# SDD_CHAIN_SMART=antigravity:,gemini:gemini-3.8-flash,groq:openai/gpt-oss-120b
# SDD_CHAIN_FAST=gemini:gemini-3.5-flash-lite,cerebras:gpt-oss-120b

# --- Telegram (solo si TRANSPORT_MODE=telegram) -------------------------------
# @BotFather → /newbot. Tu chat id: escribe al bot y abre
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# --- Sistema ------------------------------------------------------------------
ENGRAM_DB_PATH=./memory/engram.db
WORKSPACES_PATH=./workspaces
LOG_LEVEL=INFO
HTTP_PORT=8000
# "telegram" | "cli" | "voice"
TRANSPORT_MODE=cli
