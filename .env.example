# =============================================================================
# SDD ECOSYSTEM — VARIABLES DE ENTORNO
# Copia este archivo como .env y rellena con tus claves reales.
# NUNCA hagas commit del .env con claves reales.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. ANTHROPIC (Claude) — MODELO PRINCIPAL DE RAZONAMIENTO
# -----------------------------------------------------------------------------
# Obtener en: https://console.anthropic.com → "API Keys" → "Create Key"
# Plan recomendado: Pro ($20/mes) o Team
# Modelos disponibles:
#   claude-opus-4-7          → Máximo razonamiento (caro, usar con moderación)
#   claude-sonnet-4-6        → RECOMENDADO: balance perfecto calidad/costo
#   claude-haiku-4-5         → Ultra rápido, tareas simples
# Uso en el DAG: architecture_agent, code_review_agent, verifier
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Modelo por defecto de Claude a usar en el sistema
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
CLAUDE_HEAVY_MODEL=claude-opus-4-7
CLAUDE_FAST_MODEL=claude-haiku-4-5-20251001


# -----------------------------------------------------------------------------
# 2. GROQ — INFERENCIA ULTRARRÁPIDA (FREE TIER GENEROSO)
# -----------------------------------------------------------------------------
# Obtener en: https://console.groq.com → "API Keys" → "Create API Key"
# FREE: 30 req/min, 6000 tokens/min — suficiente para desarrollo completo
# Modelos gratis disponibles:
#   llama-3.3-70b-versatile        → Principal: discovery, requirements
#   llama-3.1-8b-instant           → Rápido: hu_writer, task_planner
#   llama-3.2-11b-vision-preview   → VISIÓN: ux_ui_agent, visual_check
#   gemma2-9b-it                   → QA y análisis lógico
#   mixtral-8x7b-32768             → Contexto largo (32k): arquitectura
# Compatible 100% con OpenAI SDK. Base URL: https://api.groq.com/openai/v1
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_LONG_CTX_MODEL=mixtral-8x7b-32768


# -----------------------------------------------------------------------------
# 3. NVIDIA NIM — MODELOS PESADOS (LLAVES YA CONFIGURADAS)
# -----------------------------------------------------------------------------
# Portal: https://integrate.api.nvidia.com
# Base URL: https://integrate.api.nvidia.com/v1
# Compatible con OpenAI SDK
# Modelos recomendados:
#   meta/llama-3.1-70b-instruct   → Backend agent, implementación
#   qwen/qwen2.5-coder-7b         → Frontend + código específico
#   moondream/moondream2          → Visual check local/remoto
# -----------------------------------------------------------------------------
NVIDIA_HEAVY_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NVIDIA_FAST_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NVIDIA_VISION_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

NVIDIA_DEFAULT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_CODE_MODEL=qwen/qwen2.5-coder-7b-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct


# -----------------------------------------------------------------------------
# 4. TELEGRAM BOT — INTERFAZ DE CONTROL
# -----------------------------------------------------------------------------
# Obtener en: Telegram → buscar @BotFather → /newbot
# Pasos:
#   1. Escribe /newbot en @BotFather
#   2. Elige nombre: "SDD Orchestrator" (o el que quieras)
#   3. Elige username: "sdd_orquestador_bot" (debe terminar en 'bot')
#   4. BotFather te da el token. Pégate aquí.
# Para obtener tu CHAT_ID:
#   1. Escribe cualquier mensaje a tu bot nuevo
#   2. Visita: https://api.telegram.org/bot<TU_TOKEN>/getUpdates
#   3. Busca "chat":{"id": XXXXXXXXX} — ese es tu chat_id
# -----------------------------------------------------------------------------
TELEGRAM_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_ALLOWED_CHAT_ID=1234567890


# -----------------------------------------------------------------------------
# 5. CONFIGURACIÓN DEL SISTEMA
# -----------------------------------------------------------------------------
ENGRAM_DB_PATH=./memory/engram.db
WORKSPACES_PATH=./workspaces
LOG_LEVEL=INFO

# Puerto del servidor HTTP (para webhook de Telegram o API REST futura)
HTTP_PORT=8000

# Modo de transporte: "telegram" | "cli" | "http"
TRANSPORT_MODE=telegram
